{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@dsm/core": ["./../packages/core/src/index.ts"],
      "@dsm/desktop-runtime": ["./../packages/desktop-runtime/src/index.ts"],
      "jsdsm": ["./../apps/jsdsm/src/index.ts"]
    }
  },
  "include": [
    "./**/*.ts",
    "../packages/core/src/**/*.ts",
    "../packages/desktop-runtime/src/**/*.ts",
    "../apps/jsdsm/src/**/*.ts",
    "../scripts/**/*.ts"
  ]
}
